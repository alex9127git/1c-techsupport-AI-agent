# Копия конфигурационных переменных по умолчанию. Скопируйте в config/.env
# и при необходимости переопределите значения.
APP_NAME=1C Techsupport AI Agent
DEBUG=false

# Смена на PostgreSQL для продакшна (когда станет много пользователей):
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./app.db

CONFIDENCE_THRESHOLD=80
ESCALATION_STRATEGY=human_review

# --- AI-ядро (обязательные для реальной работы) ---
# AUTH_KEY: ключ GigaChat (Sber). Секрет! Не коммить. Заполнить в config/.env.
AUTH_KEY=your_gigachat_auth_key
# HF_TOKEN: токен Hugging Face (опционально, для публичной e5-модели не обязателен).
HF_TOKEN=

# Папка с документами для RAG-индексации (Этап 2).
DOCS_DIR=data/docs
